{
  "name": "@plane/web-next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:css && bun build app/entry.tsx --outdir=../app/dist/web --splitting --watch",
    "dev:css": "bunx @tailwindcss/cli -i ./app/styles.css -o ../app/dist/web/entry.css --watch",
    "build:css": "bunx @tailwindcss/cli -i ./app/styles.css -o ../app/dist/web/entry.css --minify",
    "build:js": "bun build app/entry.tsx --outdir=../app/dist/web --minify --splitting",
    "build": "bun run build:css && bun run build:js && cp index.html ../app/dist/web/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.16",
    "@tanstack/react-query-devtools": "^5.62.16",
    "better-auth": "^1.4.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-router": "^7.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2"
  }
}
