{
  "name": "plane-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "worker": "bun src/worker.ts",
    "db:generate": "drizzle-kit generate",
