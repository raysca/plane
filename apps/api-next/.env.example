# ===========================================
# Plane API - Environment Configuration
# ===========================================

# Server
PORT=8000
NODE_ENV=development

# Database
# For local development, use SQLite file
DATABASE_URL=file:./data/plane.db

# For production with Turso/LibSQL:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# Better Auth
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:8000

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3001

# ===========================================
# OAuth Providers (all optional)
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab OAuth
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=https://gitlab.com

# Gitea OAuth (self-hosted)
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
GITEA_ISSUER=https://gitea.example.com

# ===========================================
# Email (optional - for magic links, password reset)
# ===========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourplane.app

# ===========================================
# File Storage (optional)
# ===========================================

# Storage provider: 'local', 's3', 'r2'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# S3/R2 Configuration
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================
# Optional Features
# ===========================================

# OpenAI for AI features
OPENAI_API_KEY=

# Sentry for error tracking
SENTRY_DSN=

# Redis for caching (optional, uses in-memory by default)
REDIS_URL=
